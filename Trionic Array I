class Solution {
    public boolean isTrionic(int[] nums) {
        boolean f1=false;
        boolean f2=false;
        boolean f3=false;
        int i=1;
            while(i<nums.length&&nums[i]>nums[i-1]){
                i++;
                f1=true;
            }
            while(i<nums.length&&nums[i]<nums[i-1]){
                i++;
                f2=true;
                }
           while(i<nums.length&&nums[i]>nums[i-1]){
            i++;
            f3=true;
            }
        

        return f1&&f2&&f3&&(i==nums.length);
    }
}
