class Solution {
    public boolean canPartitionGrid(int[][] grid) {
        long x=0;
        long arr1[]=new long[grid.length];
        for(int i=0;i<grid.length;i++){
            for(int j=0;j<grid[0].length;j++){
                x+=grid[i][j];
            }
            arr1[i]=x;
        }
        for(int i=0;i<grid.length;i++){
            if(arr1[i]*2==x){
                return true;
            }
        }
        long temp=0;
        for(int i=0;i<grid[0].length;i++){
            for(int j=0;j<grid.length;j++){
                temp+=grid[j][i];
            }
            if(temp*2==x)return true;
        }
        return false;
    }
}
