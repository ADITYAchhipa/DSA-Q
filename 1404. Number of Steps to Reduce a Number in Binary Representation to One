class Solution {
    public int numSteps(String s) {
        int count=0;
        char arr[]=s.toCharArray();
        for(int i=arr.length-1;i>0;i--){
            if(arr[i]=='1'){
                count+=2;
                int temp=i;
                while(temp>=0&&arr[temp]=='1'){
                    arr[temp]='0';
                    temp--;
                }
                if(temp<0){
                    arr[0]='1';
                    i++;
                }
                else{
                    arr[temp]='1';
                }
            }else{
                count++;
            }
        }
        return count;
    }
}

