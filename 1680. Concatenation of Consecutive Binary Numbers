class Solution {
    public int concatenatedBinary(int n) {
        long result=0;
        int bits=0;
        int mod=(int)Math.pow(10,9)+7;
        for(int i=1;i<=n;i++){
            if((i&(i-1))==0){
                bits++;
            }
            result=(((result<<bits)%mod)+i)%mod;
            // System.out.println(i+" "+result);
        }
        return (int)result;
    }
}
