class Solution {
    public String addBinary(String a, String b) {
     int carry = 0;
     if(a.length()<b.length()){
        String temp =a;
        a=b;
        b=temp;
     }
     int n = a.length()-1;
     StringBuilder str = new StringBuilder();
     for(int i=b.length()-1;i>=0;i--){
        if(b.charAt(i)=='1'&&a.charAt(n)=='1'){
            if(carry==1)str.insert(0,"1");
            else str.insert(0,"0");
            carry =1;
        }
        else if (b.charAt(i)=='0'&&a.charAt(n)=='0'){
            if(carry==1)str.insert(0,"1");
            else str.insert(0,"0");
            carry =0;
        }
        else{
            if(carry==1)str.insert(0,"0");
            else str.insert(0,"1");
        }
        n--;

     }
    
     while(n>=0){
        if(a.charAt(n)=='1'){
    
            if(carry==1)str.insert(0,"0");
            else{
                str.insert(0,"1");
                carry=0;
            }
        }
        else{
            if(carry==1){str.insert(0,"1");carry=0;}
            else{
                str.insert(0,"0");
            }
        } 
        n--;
     }
    
     if(carry==1)str.insert(0,"1");
     return str.toString();

    }
}
